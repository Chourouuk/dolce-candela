# Copier ce fichier en .env et remplacer TOUTES les valeurs. Ne jamais committer .env.

POSTGRES_DB=dolce_candela
POSTGRES_USER=dolce
POSTGRES_PASSWORD=change-me-strong-db-password

# Au moins 32 caractères aléatoires. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Compte administrateur créé au premier démarrage (mot de passe : 12 caractères minimum)
ADMIN_EMAIL=admin@dolcecandela.tn
ADMIN_PASSWORD=change-me-admin-password

# URL du front Angular (plusieurs valeurs séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Mettre false en production pour masquer Swagger
SWAGGER_ENABLED=true

# Port de l API sur ta machine (8080 est souvent pris par Oracle XE ou Jenkins)
API_PORT=8081
